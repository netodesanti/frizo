rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are listed in /admins/{uid}. Anyone can create a Firebase Auth
    // account with the public config, so being signed in is not enough.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public website reads active products only (queries must filter active == true).
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // The admin list itself is only managed from the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
